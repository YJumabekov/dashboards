{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$root='C:\\Users\\YJuma\\OneDrive\\Документы\\Claude Code\\Dashboards'; $l=New-Object System.Net.HttpListener; $l.Prefixes.Add('http://localhost:3030/'); $l.Start(); $mime=@{'.html'='text/html';'.css'='text/css';'.js'='application/javascript';'.json'='application/json';'.png'='image/png';'.jpg'='image/jpeg';'.svg'='image/svg+xml'}; while($l.IsListening){$c=$l.GetContext();$r=$c.Request;$s=$c.Response;try{$p=[System.Uri]::UnescapeDataString($r.Url.AbsolutePath.TrimStart('/'));if([string]::IsNullOrWhiteSpace($p)){$p='index.html'};$f=Join-Path $root $p;if(Test-Path $f -PathType Leaf){$e=[System.IO.Path]::GetExtension($f).ToLower();$ct=$mime[$e];if(-not $ct){$ct='application/octet-stream'};$b=[System.IO.File]::ReadAllBytes($f);$s.ContentType=$ct;$s.ContentLength64=$b.Length;$s.OutputStream.Write($b,0,$b.Length)}else{$s.StatusCode=404}}catch{$s.StatusCode=500}finally{$s.OutputStream.Close()}}"],
      "port": 3030
    }
  ]
}
